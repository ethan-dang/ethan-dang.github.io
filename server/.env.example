# Port the API listens on locally
PORT=3000

# Comma-separated list of origins allowed to call this API
ALLOWED_ORIGINS=http://localhost:8080,https://ethan-dang.github.io

# Where contact form submissions should be delivered
CONTACT_TO_EMAIL=ethandang2223@gmail.com

# Resend (https://resend.com) API key used to send the notification email.
# Sends over HTTPS rather than SMTP, since many hosts (Render's free tier
# included) block outbound SMTP ports.
RESEND_API_KEY=your-resend-api-key

# Optional: sender shown on the email. Without a verified domain on Resend,
# leave this as the default onboarding@resend.com — Resend only allows that
# address to send to your own account email (CONTACT_TO_EMAIL), which is
# exactly this form's use case.
RESEND_FROM_EMAIL=Website Contact Form <onboarding@resend.com>
