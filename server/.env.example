# Port the API listens on locally
PORT=3000

# Comma-separated list of origins allowed to call this API
ALLOWED_ORIGINS=http://localhost:8080,https://ethan-dang.github.io

# Where contact form submissions should be delivered
CONTACT_TO_EMAIL=nguyen180904@gmail.com

# SMTP credentials used to send the notification email.
# Example values work for Gmail with an App Password (not your normal password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-smtp-username@gmail.com
SMTP_PASS=your-smtp-app-password
